
docker network create pg-network

# 2. Run the Postgres container
docker run -it \
  -e POSTGRES_USER="root" \
  -e POSTGRES_PASSWORD="root" \
  -e POSTGRES_DB="ny_taxi" \
  -v $(pwd)/ny_taxi_postgres_data:/var/lib/postgresql/data \
  -p 5432:5432 \
  --network=pg-network \
  --name pg-database \
  postgres:16

# 3. Connect via pgcli to verify the database is running
pgcli -h localhost -p 5432 -u root -d ny_taxi

# 4. Run pgAdmin
docker run -it \
  -e PGADMIN_DEFAULT_EMAIL="admin@admin.com" \
  -e PGADMIN_DEFAULT_PASSWORD="root" \
  -p 8080:80 \
  --network=pg-network \
  --name pgadmin \
  dpage/pgadmin4:8.6

# 5. Build the ingestion image
docker build -t taxi_ingest:v001 .

# 6. Run the ingestion container
docker run -it \
  --network=pg-network \
  taxi_ingest:v001 \
    --user=root \
    --password=root \
    --host=pg-database \
    --port=5432 \
    --db=ny_taxi \
    --table_name_1=yellow_taxi_data \
    --table_name_2=yellow_taxi_zone_data \
    --url_1="https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2024-01.csv" \
    --url_2="https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv"